// Prisma Schema for SLN Groups Real Estate Corporate Website (SQLite Local Mode)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                 String    @id @default(uuid())
  slug               String    @unique
  title              String
  tagline            String
  description        String
  category           String
  propertyType       String
  location           String
  address            String
  city               String
  state              String
  pincode            String?
  latitude           Float?
  longitude          Float?
  totalAreaSqFt      String
  unitsCount         String?
  floors             String?
  completionYear     String?
  expectedPossession String?
  featuredImage      String
  galleryImages      String? // JSON string
  amenities          String? // JSON string
  highlights         String? // JSON string
  specifications     String? // JSON string
  floorPlans         String? // JSON string
  brochureUrl        String?
  virtualTourUrl     String?
  videoUrl           String?
  isFeatured         Boolean   @default(false)
  isPublished        Boolean   @default(true)
  orderIndex         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  inquiries          Inquiry[]
}

model LeadershipMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  department  String   @default("LEADERSHIP") // LEADERSHIP, MANAGEMENT, ADVISORY
  bio         String
  photoUrl    String
  linkedinUrl String?
  email       String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id             String   @id @default(uuid())
  name           String
  branchType     String   @default("REGIONAL_OFFICE") // HEADQUARTERS, REGIONAL_OFFICE, EXPERIENCE_CENTER
  address        String
  city           String
  state          String
  pincode        String?
  phone          String
  email          String
  workingHours   String   @default("Mon - Sat: 9:30 AM - 6:30 PM")
  mapEmbedUrl    String
  directionsUrl  String?
  photoUrl       String
  isHeadquarters Boolean  @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaItem {
  id           String   @id @default(uuid())
  title        String
  category     String   @default("PROJECTS")
  mediaType    String   @default("IMAGE") // IMAGE or VIDEO
  url          String
  thumbnailUrl String?
  caption      String?
  eventDate    String?
  isFeatured   Boolean  @default(false)
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inquiry {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  subject                String?
  message                String
  projectInterest        String?
  budgetRange            String?
  preferredContactMethod String?  @default("PHONE")
  status                 String   @default("NEW")
  adminNotes             String?
  projectId              String?
  project                Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SiteContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique
  title      String?
  content    String // JSON string
  updatedAt  DateTime @updatedAt
}
