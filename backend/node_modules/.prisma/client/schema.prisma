// Prisma Schema for SLN Groups Real Estate Corporate Website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProjectCategory {
  COMPLETED
  ONGOING
  UPCOMING
}

enum PropertyType {
  RESIDENTIAL_LUXURY
  COMMERCIAL_LANDMARK
  PLOTTED_DEVELOPMENT
  EXCLUSIVE_VILLAS
  INTEGRATED_TOWNSHIP
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum MediaCategory {
  ALL
  PROJECTS
  COMPLETED_DEVELOPMENTS
  CONSTRUCTION_PROGRESS
  CORPORATE_EVENTS
  TEAM_CELEBRATIONS
  OFFICE_BRANCHES
  AWARDS_RECOGNITION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                 String          @id @default(uuid())
  slug               String          @unique
  title              String
  tagline            String
  description        String          @db.Text
  category           ProjectCategory
  propertyType       PropertyType
  location           String
  address            String
  city               String
  state              String
  pincode            String?
  latitude           Float?
  longitude          Float?
  totalAreaSqFt      String
  unitsCount         String?
  floors             String?
  completionYear     String?
  expectedPossession String?
  featuredImage      String
  galleryImages      String[]        @default([])
  amenities          String[]        @default([])
  highlights         String[]        @default([])
  specifications     Json?
  floorPlans         Json?
  brochureUrl        String?
  virtualTourUrl     String?
  videoUrl           String?
  isFeatured         Boolean         @default(false)
  isPublished        Boolean         @default(true)
  orderIndex         Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inquiries          Inquiry[]
}

model LeadershipMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  department  String   @default("LEADERSHIP") // LEADERSHIP, MANAGEMENT, ADVISORY
  bio         String   @db.Text
  photoUrl    String
  linkedinUrl String?
  email       String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id             String   @id @default(uuid())
  name           String
  branchType     String   @default("REGIONAL_OFFICE") // HEADQUARTERS, REGIONAL_OFFICE, EXPERIENCE_CENTER
  address        String
  city           String
  state          String
  pincode        String?
  phone          String
  email          String
  workingHours   String   @default("Mon - Sat: 9:30 AM - 6:30 PM")
  mapEmbedUrl    String   @db.Text
  directionsUrl  String?
  photoUrl       String
  isHeadquarters Boolean  @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaItem {
  id           String        @id @default(uuid())
  title        String
  category     MediaCategory @default(PROJECTS)
  mediaType    String        @default("IMAGE") // IMAGE or VIDEO
  url          String
  thumbnailUrl String?
  caption      String?
  eventDate    String?
  isFeatured   Boolean       @default(false)
  orderIndex   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Inquiry {
  id                     String        @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  subject                String?
  message                String        @db.Text
  projectInterest        String?
  budgetRange            String?
  preferredContactMethod String?       @default("PHONE")
  status                 InquiryStatus @default(NEW)
  adminNotes             String?       @db.Text
  projectId              String?
  project                Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model SiteContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique
  title      String?
  content    Json
  updatedAt  DateTime @updatedAt
}
